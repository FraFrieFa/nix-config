#!/usr/bin/env bash
set -euo pipefail

qmp="${INSTALLER_VM_QMP:-/tmp/nixos-installer-test.qmp}"

if [ ! -S "$qmp" ]; then
  echo "QEMU QMP socket not found: $qmp" >&2
  echo "Start the VM with installer/scripts/qemu-run first." >&2
  exit 1
fi

if [ "$#" -eq 0 ]; then
  echo "usage: $0 JSON_COMMAND" >&2
  echo "example: $0 '{\"execute\":\"query-status\"}'" >&2
  exit 1
fi

{
  printf '%s\n' '{"execute":"qmp_capabilities"}'
  printf '%s\n' "$*"
} | socat -t 2 - "UNIX-CONNECT:$qmp"
