#!/usr/bin/env bash
set -euo pipefail

session="${INSTALLER_VM_TMUX_SESSION:-nixos-installer}"
target="${1:-$session:0.0}"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  cat <<'EOF'
Usage: qemu-screen [tmux-target]

Print the current visible QEMU/tmux screen, trimmed of blank outer rows/columns.
EOF
  exit 0
fi

tmux capture-pane -p -t "$target" | awk '
  {
    sub(/[[:space:]]+$/, "")
    lines[NR] = $0
    if ($0 != "") {
      if (!first) first = NR
      last = NR
      match($0, /[^[:space:]]/)
      indent = RSTART - 1
      if (!have_min || indent < min_indent) {
        min_indent = indent
        have_min = 1
      }
    }
  }
  END {
    if (!first) exit
    for (i = first; i <= last; i++)
      print substr(lines[i], min_indent + 1)
  }
'
