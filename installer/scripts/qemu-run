#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
disk="${INSTALLER_VM_DISK:-/tmp/nixos-installer-test.qcow2}"
disk_format="${INSTALLER_VM_DISK_FORMAT:-qcow2}"
qmp="${INSTALLER_VM_QMP:-/tmp/nixos-installer-test.qmp}"
vnc_display="${INSTALLER_VM_VNC:-}"
memory="${INSTALLER_VM_MEMORY:-4096}"
iso_glob="${INSTALLER_VM_ISO:-$repo_root/result/iso/*.iso}"

iso_count=0
iso=""
for candidate in $iso_glob; do
  iso="$candidate"
  iso_count=$((iso_count + 1))
done

if [ "$iso_count" -ne 1 ]; then
  echo "Expected exactly one ISO at: $iso_glob" >&2
  echo "Build it first: nix --extra-experimental-features nix-command --extra-experimental-features flakes build .#installer" >&2
  exit 1
fi

if [ ! -e "$disk" ]; then
  if [ "$disk_format" = "raw" ]; then
    truncate -s 80G "$disk"
  else
    qemu-img create -f "$disk_format" "$disk" 80G
  fi
fi

rm -f "$qmp"

accel=()
if [ -e /dev/kvm ]; then
  accel=(-enable-kvm)
else
  accel=(-accel tcg)
fi

if [ -n "$vnc_display" ]; then
  display=(-display "vnc=$vnc_display")
  serial=(-serial stdio)
else
  display=(-display curses)
  serial=()
fi

firmware=()
if [ -n "${INSTALLER_VM_OVMF_CODE:-}" ]; then
  firmware=(-drive "if=pflash,format=raw,readonly=on,file=$INSTALLER_VM_OVMF_CODE")
elif [ -e /run/libvirt/nix-ovmf/OVMF_CODE.fd ] && [ -e /run/libvirt/nix-ovmf/OVMF_VARS.fd ]; then
  vars="/tmp/nixos-installer-test-OVMF_VARS.fd"
  cp /run/libvirt/nix-ovmf/OVMF_VARS.fd "$vars"
  firmware=(
    -drive "if=pflash,format=raw,readonly=on,file=/run/libvirt/nix-ovmf/OVMF_CODE.fd"
    -drive "if=pflash,format=raw,file=$vars"
  )
fi

exec qemu-system-x86_64 \
  "${accel[@]}" \
  "${firmware[@]}" \
  -m "$memory" \
  -boot d \
  -cdrom "$iso" \
  -drive "file=$disk,format=$disk_format,if=virtio" \
  -netdev user,id=net0,hostfwd=tcp::2222-:22 \
  -device virtio-net-pci,netdev=net0 \
  -qmp "unix:$qmp,server,nowait" \
  "${display[@]}" \
  "${serial[@]}"
