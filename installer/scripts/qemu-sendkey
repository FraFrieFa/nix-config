#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: $0 KEY" >&2
  echo "examples: $0 ret, $0 enter, $0 down, $0 tab, $0 ctrl-alt-f2" >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
IFS='-' read -r -a keys <<< "$1"

json_keys=""
for key in "${keys[@]}"; do
  case "$key" in
    enter) key="ret" ;;
    esc) key="esc" ;;
  esac

  item="{\"type\":\"qcode\",\"data\":\"$key\"}"
  if [ -n "$json_keys" ]; then
    json_keys="$json_keys,$item"
  else
    json_keys="$item"
  fi
done

"$repo_root/installer/scripts/qemu-qmp" \
  "{\"execute\":\"send-key\",\"arguments\":{\"keys\":[$json_keys]}}" >/dev/null
